# false：优先使用 AKShare 真实公开数据；true：只用固定演示资料
USE_DEMO_DATA=false
# false：ETF工具优先读取真实名单与定期披露；true：固定使用内置演示样本
ETF_USE_DEMO_DATA=false
# 单个 ETF 公开数据请求最多等待秒数；超时后自动使用缓存或明确标注的演示数据
ETF_UPSTREAM_TIMEOUT_SECONDS=5
DATABASE_PATH=data/anshin.db
DATA_CACHE_DIR=data/cache
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:8000,http://localhost:8000
# AI_PROVIDER=mock|openai|compatible (AI_REPORT_PROVIDER is a legacy alias)
AI_PROVIDER=compatible
# AI_REPORT_PROVIDER=mock
AI_DISPLAY_NAME=HKGAI
AI_MODEL=REPLACE_WITH_HKGAI_MODEL_NAME
AI_API_MODE=chat
# 允许网页新增模型密钥时必须配置 Fernet 主密钥；未配置时只能引用服务器环境变量。
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AI_PROVIDER_ENCRYPTION_KEY=
# 可选：只有服务器管理员调用模型连接管理 API 时才需要；不要放入网页。
# AI_PROVIDER_ADMIN_TOKEN=
# OPENAI_BASE_URL=https://api.openai.com/v1
# HKGAI typically uses the OpenAI-compatible Chat Completions endpoint.
OPENAI_BASE_URL=https://test-new-api.hkchat.app/v1
# OPENAI_API_KEY=请仅在服务器 Secrets 中设置新生成的 HKGAI Key

# APP_PASSWORD、OPENAI_API_KEY 和 TUSHARE_TOKEN 请放入
# .streamlit/secrets.toml，不要写入 .env 或提交到 Git。
MVP_PILOT_ENABLED=false
# Server-side invite codes for the controlled Strategy Lab study. Never expose real codes in this file.
MVP_PILOT_EXTERNAL_CODE=
MVP_PILOT_INTERNAL_CODE=
MVP_PILOT_REVIEW_CODE=
MVP_STUDY_HASH_KEY=
NEXT_PUBLIC_BUILD_ID=local-unversioned
